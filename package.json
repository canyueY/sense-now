{
  "name": "sense-now",
  "version": "0.1.0",
  "description": "Sense Now lets DSH watch live screens and build subtitle-first, searchable long-video indexes for on-demand multimodal Q&A. · 见闻：实时陪看 + 长视频索引问答。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "screen-capture",
    "vision",
    "llm",
    "ffmpeg",
    "realtime",
    "token-efficient",
    "multimodal",
    "subtitle-first",
    "long-video"
  ],
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./pack": "./src/pack.js",
    "./png": "./src/png.js",
    "./pipeline": "./src/pipeline.js",
    "./capture": "./src/capture.js",
    "./chat": "./src/chat.js",
    "./speech": "./src/speech.js",
    "./voice": "./src/voice.js",
    "./interject": "./src/interject.js",
    "./window": "./src/window.js",
    "./runner": "./src/runner.js",
    "./loop": "./src/loop.js",
    "./timer": "./src/timer.js",
    "./tool-spec": "./src/tool-spec.js",
    "./video-index": "./src/video-index/video-index-engine.js",
    "./video-index-tool": "./src/video-index-tool.js",
    "./video-index/schema": "./src/video-index/schema.js",
    "./video-index/ids": "./src/video-index/ids.js",
    "./video-index/evidence-package": "./src/video-index/evidence-package.js",
    "./video-index/pyannote-runner": "./src/video-index/adapters/pyannote-runner.js"
  },
  "files": [
    "src",
    "scripts/*.py",
    "scripts/*.mjs",
    "scripts/*.md",
    "examples/floating-chat/*.py",
    "examples/floating-chat/*.png",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "docs/images",
    "docs/V1.1-COMPOSER-GROK-IMPLEMENTATION.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "debug:live": "node debug/live.mjs",
    "install-dev": "node scripts/install-dev.mjs",
    "check": "node scripts/install-dev.mjs --check",
    "sync:window": "node scripts/sync-window.mjs",
    "check:window": "node scripts/sync-window.mjs --check",
    "prepack": "node scripts/sync-window.mjs",
    "bench:video-index": "node scripts/bench-video-index.mjs --synthetic",
    "bench:long-video": "node scripts/bench-long-video.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canyueY/sense-now.git"
  },
  "homepage": "https://github.com/canyueY/sense-now#readme",
  "bugs": {
    "url": "https://github.com/canyueY/sense-now/issues"
  }
}
